{
  "name": "qr-emergencias-app",
  "version": "1.0.0",
  "description": "Sistema de gestión de fichas médicas de emergencia y generación de códigos QR para atención rápida de paramédicos.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:dashboard": "esbuild src/dashboard.jsx --bundle --format=iife --platform=browser --target=es2020 --outfile=public/js/dashboard.bundle.js",
    "test": "node --test"
  },
  "keywords": [
    "qr-code",
    "emergency",
    "medical-id",
    "express",
    "paramedics",
    "healthcare"
  ],
  "author": "Dashboard Emergencias",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
