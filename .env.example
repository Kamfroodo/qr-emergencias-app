# Puerto local. Render configura PORT automáticamente (10000 por defecto).
PORT=3000

# Entorno local. Para despliegue, cambia a production y configura los secretos indicados abajo.
NODE_ENV=development

# URL base para los enlaces y códigos QR generados
BASE_URL=http://localhost:3000

# Configuración de Base de Datos en la Nube (Supabase PostgreSQL)
# En desarrollo local pueden dejarse vacías para usar memoria (los datos no persisten).
# Para Supabase, el backend necesita una clave service_role; nunca uses la anon/public key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=medical-photos

# En producción: genera un valor aleatorio de al menos 32 caracteres y guárdalo solo en el servidor.
# PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Linux/macOS: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=24h
